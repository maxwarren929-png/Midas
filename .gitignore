# Prompt 9 markets, materialized run configs, checkpoints, and raw worker output
# are deterministic from tracked manifests/specifications. Compact aggregate
# tables and provenance metadata remain tracked.
/data/prompt9/*/
!/data/prompt9/manifests/
/configs/prompt9/runs/
/reports/prompt9/raw/
/reports/prompt9/logs/
/reports/prompt9/*-run-manifest.csv
